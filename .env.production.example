# Production .env for the VPS (copy to .env, never commit it). See docs/DEPLOIEMENT.md.

# Lets plain `docker compose build / up -d` use the production file, like the other apps
COMPOSE_FILE=docker-compose.prod.yml

# Postgres password (hex only, it goes into DATABASE_URL): openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
# JWT signing key: openssl rand -hex 32
SECRET_KEY=CHANGE_ME

# DATABASE_URL is built by docker-compose.prod.yml from POSTGRES_PASSWORD
REDIS_URL=redis://redis:6379/0
SCANS_DIR=/srv/data/scans
SCAN_TIMEOUT_SECONDS=1800
MAX_SCANS_PER_DAY=5
RETENTION_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=720
# Front and API share one origin in production
CORS_ORIGINS=https://surfaceattackwatch.com

# Proxies trusted for X-Forwarded-For. "*" is fine as long as the web container publishes
# no port; narrow it to the "web" network subnet (docker network inspect web) if you prefer.
FORWARDED_ALLOW_IPS=*

# Base URL used in e-mail links (password reset, scan notifications)
PUBLIC_URL=https://surfaceattackwatch.com

# E-mail over your own SMTP account (EU provider recommended, GDPR).
# Leave SMTP_HOST empty to disable e-mail: no "forgot password", no notifications.
# Prefer the /admin page (stored in the database, takes precedence): these are a fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@surfaceattackwatch.com
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
