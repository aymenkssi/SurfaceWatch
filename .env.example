SECRET_KEY=change-me-with-a-long-random-string
DATABASE_URL=postgresql+psycopg://surfacewatch:surfacewatch@db:5432/surfacewatch
REDIS_URL=redis://redis:6379/0
SCANS_DIR=/srv/data/scans
SCAN_TIMEOUT_SECONDS=1800
MAX_SCANS_PER_DAY=5
RETENTION_DAYS=30
# Only needed when the React dev server (Vite, :5173) calls the API directly
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_TTL_MINUTES=720
# Base URL used in e-mail links
PUBLIC_URL=http://localhost:8000

# E-mail (password reset, scan notifications). Leave SMTP_HOST empty to disable.
# Prefer the /admin page (stored in the database, takes precedence): these are a fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
